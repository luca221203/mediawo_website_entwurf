---
// Gründer-Section. Daten & Fotos: src/data/site.ts (team)
import { team as founders } from '../data/site';
---

<section class="founders" id="team">
  <div class="founders-inner container">
    <div class="founders-text">
      <p class="eyebrow">(04) Die Gründer</p>
      <h2 class="founders-title" data-split>Zwei Freunde, eine Agentur.</h2>
      <p class="founders-copy reveal">
        Wir kennen uns seit der fünften Klasse. Heute führen wir gemeinsam Mediawo – der eine mit BWL-Studium,
        der andere mit Mediendesign im Rücken. Diese Mischung aus Strategie und Kreativität ist unsere Stärke.
        Bei uns haben Sie feste Ansprechpartner, die zuhören, ehrlich beraten und anpacken.
      </p>
      <a href="/ueber-uns" class="founders-cta reveal">Mehr erfahren <span aria-hidden="true">→</span></a>
    </div>

    <ul class="founders-people">
      {founders.map((f, i) => (
        <li class="person reveal" style={`transition-delay:${i * 120}ms`}>
          <div class="person-media">
            {f.image
              ? <img src={f.image} alt={f.name} loading="lazy" />
              : <div class="person-ph" aria-hidden="true"><span>{f.initials}</span><small>Foto folgt</small></div>}
          </div>
          <p class="person-name">{f.name}</p>
          <p class="person-role">{f.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .founders {
    display: flex; align-items: center;
    background: var(--c-red); color: var(--c-white);
    padding-block: clamp(96px, 10vw, 160px);
  }
  .founders-inner {
    width: 100%;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(40px, 6vw, 112px); align-items: center;
    transform-origin: center top;
  }
  .founders .eyebrow { color: rgba(255, 255, 255, 0.75); }
  .founders-text { display: grid; gap: 28px; align-content: center; }
  .founders-title { font-size: clamp(1.9rem, 3.8vw, 3.8rem); max-width: 14ch; }
  .founders-copy { max-width: 44ch; font-weight: 300; line-height: 1.75; color: rgba(255, 255, 255, 0.88); }
  .founders-cta {
    width: fit-content; display: inline-flex; gap: 10px; align-items: center;
    padding: 15px 26px; border-radius: 99px; border: 1px solid rgba(255, 255, 255, 0.6);
    font-size: 0.9375rem; font-weight: 500;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .founders-cta:hover { background: var(--c-white); color: var(--c-red); border-color: var(--c-white); }

  .founders-people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 32px); }
  .person:nth-child(2) { margin-top: clamp(0px, 6vw, 96px); }
  .person-media { position: relative; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; background: var(--c-darkred); }
  .person-media img, .person-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .person:hover .person-media img, .person:hover .person-ph { transform: scale(1.05); }
  .person-ph {
    display: grid; place-content: center; justify-items: center; gap: 6px;
    background: radial-gradient(80% 60% at 30% 20%, rgba(255, 255, 255, 0.14), transparent 70%), var(--c-darkred);
  }
  .person-ph span { font-weight: 300; font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: 0.02em; opacity: 0.55; }
  .person-ph small { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.6; }
  .person-name { margin-top: 18px; font-size: clamp(1rem, 1.4vw, 1.25rem); font-weight: 600; text-transform: uppercase; }
  .person-role { font-size: 0.875rem; font-weight: 300; color: rgba(255, 255, 255, 0.75); }

  @media (max-width: 860px) {
    .founders-inner { grid-template-columns: 1fr; }
    .person:nth-child(2) { margin-top: 48px; }
  }
</style>

