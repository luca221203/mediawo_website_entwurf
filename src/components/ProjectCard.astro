---
import type { Project } from '../data/site';
import { placeholderBg } from '../data/placeholders';

interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
---

<li class="project reveal" style={`transition-delay:${(index % 2) * 120}ms`}>
  <a href={`/projekte/${p.slug}`} class="project-link">
    <div class={`project-media ${p.plainThumb ? 'is-plain' : ''}`}>
      {p.image
        ? <img src={p.image} alt="" loading="lazy" />
        : <div class="project-ph" style={`background:${placeholderBg(index)}`}></div>}
      {p.image && !p.plainThumb && <div class="project-tint" aria-hidden="true"></div>}
      {p.image && <div class="project-red" aria-hidden="true"></div>}
      {(p.image || p.logo) && !p.plainThumb && (
        <div class="project-logo">
          {p.logo
            ? <img src={p.logo} alt={p.client} />
            : <span class="logo-ph">Logo {p.client}</span>}
        </div>
      )}
      <div class="grain" aria-hidden="true"></div>
      <span class="project-cta">Ansehen <span aria-hidden="true">→</span></span>
    </div>
    <div class="project-info">
      <h3 data-split>{p.title}</h3>
      <span class="project-year">{p.year}</span>
    </div>
    <p class="project-cat">{p.client} · {p.category}</p>
  </a>
</li>

<style>
  .project-media {
    position: relative; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; background: #0f0f15;
  }
  .project-media > img, .project-ph {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.1s var(--ease), filter 0.8s var(--ease);
  }
  .project-link:hover .project-ph { transform: scale(1.06); filter: brightness(1.15); }
  /* Fotos dunkel, damit Verlauf und weißes Logo tragen */
  .project-media > img { filter: brightness(0.3) saturate(0.8) contrast(1.1); }
  .project-link:hover .project-media > img { transform: scale(1.06); filter: brightness(0.38) saturate(0.85) contrast(1.1); }
  /* Mockups unverändert zeigen */
  .is-plain > img, .project-link:hover .is-plain > img { filter: none; }
  .project-media .grain { opacity: 0.12; }

  /* Foto abdunkeln (ohne Farbverlauf), damit das weiße Logo trägt */
  .project-tint {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(rgba(11, 11, 16, 0.35), rgba(11, 11, 16, 0.35));
    mix-blend-mode: normal; transition: opacity 0.8s var(--ease);
  }
  /* Beim Hover: Bild leicht in Mediawo-Rot einfärben */
  .project-red {
    position: absolute; inset: 0; pointer-events: none;
    background: var(--c-red); opacity: 0; transition: opacity 0.5s var(--ease);
  }
  .project-link:hover .project-red { opacity: 0.15; }

  /* Kundenlogo mittig, komplett weiß */
  .project-logo { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .project-logo img {
    position: static; width: 30%; height: auto; max-height: 26%; object-fit: contain;
    filter: brightness(0) invert(1); transition: transform 1.1s var(--ease);
  }
  .project-link:hover .project-logo img { transform: scale(1.04); }
  .logo-ph {
    padding: 10px 18px; border: 1px dashed rgba(255, 255, 255, 0.6); border-radius: 4px;
    font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85);
  }
  .project-cta {
    position: absolute; right: 20px; bottom: 20px; display: inline-flex; gap: 8px;
    padding: 10px 18px; border-radius: 99px; font-size: 0.8125rem; font-weight: 400;
    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); backdrop-filter: blur(12px);
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.4s, transform 0.5s var(--ease);
  }
  .project-link:hover .project-cta { opacity: 1; transform: none; }

  .project-info { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-top: 22px; }
  .project-info h3 { font-size: clamp(1.15rem, 1.6vw, 1.5rem); font-weight: 600; text-transform: uppercase; letter-spacing: 0; line-height: 1.25; transition: color 0.3s; }
  .project-link:hover h3 { color: var(--c-red); }
  .project-year { color: var(--c-muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .project-cat { margin-top: 6px; color: var(--c-muted); font-size: 0.875rem; font-weight: 300; }
</style>
