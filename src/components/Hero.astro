---
const lines = ['Wir machen', 'Marken', 'sichtbar.'];
---

<section class="hero">
  <!-- Abstraktes, animiertes Lichtbild (Canvas). Später auch durch Video/Bild ersetzbar. -->
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <h1 class="hero-title container" aria-label={lines.join(' ')}>
    {lines.map((l, li) => (
      <span class="line" aria-hidden="true">
        {[...l].map((c, ci) => (
          <span class="ch" style={`--d:${li * 0.12 + ci * 0.025}s`}>{c === ' ' ? ' ' : c}</span>
        ))}
      </span>
    ))}
  </h1>

  <div class="hero-bottom container">
    <p class="hero-lead">
      Wir sind eine Medienagentur aus Trier und begleiten Unternehmen
      in Video, Social Media, Recruiting, Branding, Webdesign sowie KI & Automatisierung.
    </p>
    <a href="/kontakt" class="hero-cta">Projekt anfragen <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column;
    padding-top: 112px; padding-bottom: clamp(32px, 4vw, 56px);
    background: var(--c-ink); color: var(--c-white);
  }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .hero-shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(to top, rgba(11, 11, 16, 0.85), transparent 45%),
      linear-gradient(to right, rgba(11, 11, 16, 0.55), transparent 60%);
  }
  .hero .grain { z-index: -1; }


  .hero-title {
    margin-top: auto; padding-top: 6vh;
    font-size: clamp(2.6rem, min(10.5vw, 17svh), 12.5rem);
    font-weight: 800; line-height: 1; letter-spacing: -0.02em; text-transform: uppercase;
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .ch { display: inline-block; animation: rise 1s var(--d) var(--ease) both; }
  @keyframes rise { from { transform: translateY(110%) rotate(6deg); } to { transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .hero-bottom {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    margin-top: clamp(40px, 6vh, 72px);
    animation: fade 1.2s 0.9s var(--ease) both;
  }
  .hero-lead { max-width: 38ch; font-size: 1rem; line-height: 1.6; font-weight: 300; color: rgba(255, 255, 255, 0.82); }
  .hero-cta {
    position: relative; flex: none; display: inline-flex; align-items: center; gap: 12px; overflow: hidden;
    font-weight: 500; font-size: 0.9375rem;
    padding: 16px 28px; border-radius: 99px;
    background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10px);
    transition: border-color 0.3s, color 0.3s;
  }
  .hero-cta::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    background: var(--c-red); transform: translateY(101%); transition: transform 0.45s var(--ease);
  }
  .hero-cta { z-index: 0; }
  .hero-cta:hover { border-color: transparent; }
  .hero-cta:hover::before { transform: none; }
  .hero-cta span { transition: transform 0.4s var(--ease); }
  .hero-cta:hover span { transform: translateX(4px); }

  @media (max-width: 760px) {
    .hero-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  // Abstraktes Lichtbild: weiche, wandernde Glows + gestreckte "Licht-Streifen" in Rot/Orange.
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-canvas')!;
  const ctx = canvas.getContext('2d')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SCALE = 0.35; // niedrige Auflösung → automatisch weich, schont die Leistung

  type Blob = { x: number; y: number; r: number; c: string; a: number; sx: number; sy: number; ph: number; stretch: number; rot: number };
  const blobs: Blob[] = [
    { x: 0.72, y: 0.42, r: 0.42, c: '232,67,68', a: 0.95, sx: 0.06, sy: 0.08, ph: 0, stretch: 1, rot: 0 },
    { x: 0.86, y: 0.7, r: 0.34, c: '232,67,68', a: 0.7, sx: 0.08, sy: 0.05, ph: 2, stretch: 1, rot: 0 },
    { x: 0.6, y: 0.25, r: 0.28, c: '166,22,18', a: 0.9, sx: 0.05, sy: 0.07, ph: 4, stretch: 1, rot: 0 },
    // Licht-Streifen (stark gestreckt, wirkt wie Bewegungsunschärfe)
    { x: 0.66, y: 0.55, r: 0.3, c: '245,95,90', a: 0.5, sx: 0.1, sy: 0.03, ph: 1, stretch: 4.5, rot: -0.18 },
    { x: 0.8, y: 0.35, r: 0.22, c: '255,185,180', a: 0.28, sx: 0.07, sy: 0.04, ph: 3, stretch: 5, rot: -0.12 },
  ];
  let w = 0, h = 0, mx = 0, my = 0, tx = 0, ty = 0, raf = 0, visible = true;

  function resize() {
    w = canvas.width = Math.max(1, Math.round(canvas.clientWidth * SCALE));
    h = canvas.height = Math.max(1, Math.round(canvas.clientHeight * SCALE));
  }

  function draw(t: number) {
    mx += (tx - mx) * 0.04; my += (ty - my) * 0.04;
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = '#0b0b10';
    ctx.fillRect(0, 0, w, h);
    ctx.globalCompositeOperation = 'lighter';
    const s = Math.max(w, h);
    for (const b of blobs) {
      const x = (b.x + Math.sin(t * 0.00023 + b.ph) * b.sx + mx * 0.04) * w;
      const y = (b.y + Math.cos(t * 0.00019 + b.ph) * b.sy + my * 0.04) * h;
      const r = b.r * s * (1 + Math.sin(t * 0.0004 + b.ph) * 0.06);
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(b.rot + Math.sin(t * 0.0002 + b.ph) * 0.05);
      ctx.scale(b.stretch, 1 / Math.sqrt(b.stretch));
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, r);
      g.addColorStop(0, `rgba(${b.c},${b.a})`);
      g.addColorStop(0.45, `rgba(${b.c},${b.a * 0.35})`);
      g.addColorStop(1, `rgba(${b.c},0)`);
      ctx.fillStyle = g;
      ctx.fillRect(-r, -r, r * 2, r * 2);
      ctx.restore();
    }
    if (!reduced && visible) raf = requestAnimationFrame(draw);
  }

  resize();
  addEventListener('resize', resize);
  addEventListener('pointermove', (e) => { tx = e.clientX / innerWidth - 0.5; ty = e.clientY / innerHeight - 0.5; }, { passive: true });
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    cancelAnimationFrame(raf);
    if (visible) raf = requestAnimationFrame(draw);
  }).observe(canvas);
  draw(0);
</script>
