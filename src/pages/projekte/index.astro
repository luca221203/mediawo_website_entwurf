---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
---

<Base title="Projekte – Mediawo" description="Ausgewählte Projekte von Mediawo: Video, Social Media, Recruiting, Branding, Webdesign sowie KI & Automatisierung.">
  <PageHeader
    eyebrow="Referenzen"
    title="Projekte"
    intro="Eine Auswahl unserer Projekte – von Social-Media-Kampagnen über Corporate Design bis zur Website."
  />
  <section class="container all-projects">
    <ul class="project-grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ul>
  </section>
</Base>

<style>
  .all-projects { padding-bottom: var(--section-space); }
</style>
